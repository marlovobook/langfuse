version: '3.8'

services:
  # PostgreSQL database for Langfuse
  langfuse-db:
    image: postgres:15
    restart: always
    environment:
      POSTGRES_DB: langfuse
      POSTGRES_USER: langfuse
      POSTGRES_PASSWORD: langfuse
    volumes:
      - langfuse_db_data:/var/lib/postgresql/data
    networks:
      - langfuse-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U langfuse -d langfuse"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis for Langfuse
  langfuse-redis:
    image: redis:7-alpine
    restart: always
    networks:
      - langfuse-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ClickHouse for Langfuse analytics
  langfuse-clickhouse:
    image: clickhouse/clickhouse-server:24.1
    restart: always
    environment:
      CLICKHOUSE_DB: langfuse
      CLICKHOUSE_USER: langfuse
      CLICKHOUSE_PASSWORD: langfuse
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
    volumes:
      - langfuse_clickhouse_data:/var/lib/clickhouse
    networks:
      - langfuse-network
    healthcheck:
      test: ["CMD", "clickhouse-client", "--query", "SELECT 1"]
      interval: 30s
      timeout: 10s
      retries: 3

  # MinIO for Langfuse file storage
  langfuse-minio:
    image: minio/minio
    restart: always
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: langfuse
      MINIO_ROOT_PASSWORD: langfuse123
    volumes:
      - langfuse_minio_data:/data
    networks:
      - langfuse-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 20s
      retries: 3

  # Langfuse application
  langfuse:
    image: langfuse/langfuse:2
    restart: always
    depends_on:
      langfuse-db:
        condition: service_healthy
      langfuse-redis:
        condition: service_healthy
      langfuse-clickhouse:
        condition: service_healthy
      langfuse-minio:
        condition: service_healthy
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgresql://langfuse:langfuse@langfuse-db:5432/langfuse
      NEXTAUTH_SECRET: mysecret
      SALT: mysalt
      NEXTAUTH_URL: http://localhost:3000
      TELEMETRY_ENABLED: ${TELEMETRY_ENABLED:-true}
      LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES: ${LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES:-false}
      REDIS_CONNECTION_STRING: redis://langfuse-redis:6379
      CLICKHOUSE_URL: http://langfuse-clickhouse:8123
      CLICKHOUSE_USER: langfuse
      CLICKHOUSE_PASSWORD: langfuse
      S3_ENDPOINT: http://langfuse-minio:9000
      S3_ACCESS_KEY_ID: langfuse
      S3_SECRET_ACCESS_KEY: langfuse123
      S3_BUCKET_NAME: langfuse
      S3_REGION: us-east-1
    networks:
      - langfuse-network
      - app-network

  # Custom Backend Server (Bedrock + Langfuse)
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    restart: always
    depends_on:
      - langfuse
    ports:
      - "${BACKEND_PORT:-8081}:8081"
    environment:
      # AWS Configuration
      AWS_PROFILE: ${AWS_PROFILE}
      AWS_REGION: ${AWS_REGION:-us-east-1}
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY}
      
      # Langfuse Configuration
      LANGFUSE_HOST: http://langfuse:3000
      LANGFUSE_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
      LANGFUSE_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
      
      # Backend Configuration
      BACKEND_PORT: 8081
      DEBUG: ${DEBUG:-false}
    volumes:
      - ~/.aws:/home/appuser/.aws:ro  # Mount AWS credentials
      - ./backend:/app
    networks:
      - app-network
      - langfuse-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  # OpenWebUI
  openwebui:
    image: ghcr.io/open-webui/open-webui:main
    restart: always
    depends_on:
      - backend
    ports:
      - "${OPENWEBUI_PORT:-8080}:8080"
    environment:
      OLLAMA_BASE_URL: http://backend:8081
      OPENAI_API_BASE_URL: http://backend:8081/v1
      OPENAI_API_KEY: dummy-key  # Required by OpenWebUI but not used
      WEBUI_AUTH: ${WEBUI_AUTH:-false}
      WEBUI_SECRET_KEY: ${WEBUI_SECRET_KEY:-t0p-s3cr3t}
    volumes:
      - openwebui_data:/app/backend/data
    networks:
      - app-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/"]
      interval: 30s
      timeout: 10s
      retries: 3

volumes:
  langfuse_db_data:
  langfuse_clickhouse_data:
  langfuse_minio_data:
  openwebui_data:

networks:
  langfuse-network:
    driver: bridge
  app-network:
    driver: bridge
